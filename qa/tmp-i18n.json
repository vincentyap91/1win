    <script>
  if (navigator.userAgent.includes('Chrome')) {
    const hash = window.INITIAL_DATA.hashes.confWebAgg;

    // Готовый URL запроса SDUI-конфига собирает FSS: fetch в
    // api/endpoints/get-template-service-config.ts уходит по той же строке,
    // иначе браузер не засчитает preload и запросит конфиг второй раз.
    const templatesUrl = window.INITIAL_DATA?.sduiConfig?.templatesUrl;

    const apiPaths = [
      '/api/web/v1/user',
      ...(templatesUrl ? [`/api${templatesUrl}`] : []),
      '/api/USER-SERVICE-API/api-v3-oauth-config',
    ];

    try {
      for (const apiPath of apiPaths) {
        const link = document.createElement('link');
        link.rel = 'preload';
        link.href = apiPath;
        link.as = 'fetch';
        link.crossOrigin = '';
        document.head.append(link);
      }
    } catch (err) {
      console.warn('Preload script error', err);
    }
  }
</script>

